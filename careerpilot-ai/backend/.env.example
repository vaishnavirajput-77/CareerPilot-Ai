# Backend Environment Configuration Example
# Copy to .env for local overrides; set these in Render Environment Settings for production.

# Database: SQLite for local dev; Neon / Render PostgreSQL for production
# Local SQLite default:
DATABASE_URL=sqlite:///./careerpilot.db
# Neon PostgreSQL example:
# DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/careerpilot?sslmode=require

# CORS: Comma-separated list of allowed frontend origins
# Local default:
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Production example:
# CORS_ORIGINS=https://your-frontend.vercel.app

# JWT Authentication Secret: Must be at least 32 characters in production
JWT_SECRET_KEY=dev-careerpilot-insecure-secret-key-change-in-production-32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Cookie Security: Set to 'true' in production (HTTPS) to enable SameSite=None and Secure flags
COOKIE_SECURE=false
