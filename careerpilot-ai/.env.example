# Monorepo Environment Configuration Example
# Copy values into backend/.env and frontend/.env respectively; never commit secrets.

# Backend (set in Render Web Service Environment Settings):
DATABASE_URL=sqlite:///./careerpilot.db
# DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/careerpilot?sslmode=require
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# CORS_ORIGINS=https://your-frontend.vercel.app
JWT_SECRET_KEY=dev-careerpilot-insecure-secret-key-change-in-production-32chars
COOKIE_SECURE=false

# Frontend (set in Vercel Project Environment Settings):
# NEXT_PUBLIC_API_URL=https://your-backend.onrender.com
# BACKEND_URL=https://your-backend.onrender.com
